{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lingolink-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // URL de prod = le sous-domaine workers.dev (gardé explicitement).
  "workers_dev": true,
  // Pas d'URL de preview par version (`*-<version>.lingolink-api.workers.dev`) :
  // réduit la surface exposée, une seule URL publique.
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "triggers": {
    // Purge de rétention horaire (voir src/retention.ts).
    "crons": ["17 * * * *"]
  },
  "vars": {
    "BETTER_AUTH_URL": "https://lingolink-api.ichigo35.workers.dev",
    "APP_SCHEME": "lingolink",
    "WEB_APP_URL": "https://lingolink-web.pages.dev",
    // Chaîne de repli : essayés dans l'ordre, on passe au suivant quand le quota
    // gratuit du jour d'un modèle est épuisé (voir server/src/gemini.ts).
    "GEMINI_MODEL": "gemini-2.5-flash,gemini-3-flash-preview,gemini-3.7-flash,gemini-3.5-flash"
  },
  "durable_objects": {
    "bindings": [
      { "name": "SESSION_ROOM", "class_name": "SessionRoom" },
      { "name": "USER_INBOX", "class_name": "UserInbox" }
    ]
  },
  // Rate limiting par utilisateur du proxy Gemini (coût + anti-abus).
  // `period` ne peut valoir que 10 ou 60 s. Limiteur best-effort par colo.
  "ratelimits": [
    { "name": "MSG_RATE_LIMITER", "namespace_id": "1101", "simple": { "limit": 20, "period": 60 } },
    { "name": "AI_RATE_LIMITER", "namespace_id": "1102", "simple": { "limit": 12, "period": 60 } }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SessionRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["UserInbox"] }
  ]
}
