# Copie ce fichier en `keystore.properties` (gitignored) et renseigne les valeurs
# du keystore de release. Sans ce fichier, `assembleRelease` retombe sur la clé
# debug (OK pour tester, refusé par les stores).
#
# Générer un keystore :
#   export JAVA_HOME="/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home"
#   "$JAVA_HOME/bin/keytool" -genkeypair -v \
#     -keystore credentials/lingolink-release.jks \
#     -alias lingolink -keyalg RSA -keysize 2048 -validity 10000
#
# Le .jks et ce keystore.properties ne sont JAMAIS commités. Sauvegarde-les
# ailleurs (gestionnaire de mots de passe) : les perdre = impossible de publier
# une mise à jour de l'app sous le même identifiant.

RELEASE_STORE_FILE=lingolink-release.jks
RELEASE_STORE_PASSWORD=change-me
RELEASE_KEY_ALIAS=lingolink
RELEASE_KEY_PASSWORD=change-me
