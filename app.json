{
  "expo": {
    "name": "Lingo Link",
    "slug": "LingoLink",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lingolink",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ichigo35.lingolink"
    },
    "android": {
      "package": "com.ichigo35.lingolink",
      "adaptiveIcon": {
        "backgroundColor": "#2F6BFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "lingolink-api.ichigo35.workers.dev",
              "pathPrefix": "/join"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withAndroidReleaseSigning",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2F6BFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#0A0B0D",
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 200
          }
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Lingo Link utilise la caméra pour scanner le QR code d'une conversation."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Lingo Link utilise le micro pour transcrire et traduire ce que vous dites."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Lingo Link utilise votre position approximative uniquement quand vous choisissez d'être visible pour les personnes à proximité."
        }
      ],
      "expo-asset",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
