# ─────────────────────────────────────────────────────────────
# Variables PUBLIQUES de l'app Expo (embarquées dans le bundle).
# Copier ce fichier en `.env` pour le développement local.
# NE JAMAIS mettre ici de clé secrète (Gemini, Neon, OAuth secret).
# ─────────────────────────────────────────────────────────────

# URL de base du backend (Cloudflare Worker). En dev local : http://localhost:8787
EXPO_PUBLIC_API_BASE_URL=http://localhost:8787

# Environnement logique : development | staging | production
EXPO_PUBLIC_APP_ENV=development
